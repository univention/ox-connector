{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>univention/dev/nubus-for-k8s/common-renovate#v1.8.0"
  ],
  "logLevel": "debug",
  "dependencyDashboard": true,
  "repositories": ["univention/connector"],
  "regexManagers": [
    {
      "filePattern": "pyproject\\.toml$",
      "matchStrings": ["\"(?<dependencyName>[^\"]+)\"(?:\\s*,|\\s*\\]|\\s*\\))"],
      "datasource": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "groupName": "python dependencies",
      "automerge": false
    }
  ]
}
