{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
   "packageRules": [
     {
       "matchPackageNames": ["python"],
       "allowedVersions": "3.13.*"
     },
     {
       "groupName": "nubus-provisioning",
       "matchPackageNames": ["nubus-provisioning-consumer", "nubus-provisioning-common"]
     }
   ]

}
