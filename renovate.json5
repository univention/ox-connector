{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>univention/dev/nubus-for-k8s/common-renovate#v1.8.5"
  ],
   "packageRules": [
     {
       "matchPackageNames": ["python"],
       "allowedVersions": "3.13.*"
     },
     {
       "groupName": "nubus-provisioning",
       "matchPackageNames": ["nubus-provisioning-consumer", "nubus-provisioning-common"]
     }
   ]

}
