import sys
import logging
from argparse import ArgumentParser
from pathlib import Path
import json

from univention.ox.provisioning.key_value_store import get_old_db
from univention.ox.provisioning.helpers import normalized_dn

logger = logging.getLogger("univention.ox")
logger.setLevel(logging.INFO)
handler = logging.StreamHandler(sys.stdout)
formatter = logging.Formatter("%(name)s: %(message)s")
handler.setFormatter(formatter)
logger.addHandler(handler)
logger = logging.getLogger("listener")
logger.setLevel(logging.INFO)
handler = logging.StreamHandler(sys.stdout)
formatter = logging.Formatter("%(message)s")
handler.setFormatter(formatter)
logger.addHandler(handler)


def main(args):
    if args.fix_existing_keys:
        fix_existing_keys()
    elif args.complete_rebuild:
        complete_rebuild()

def fix_existing_keys():
    i = 0
    db = get_old_db()
    for dn, json_path in list(db.data.items()):
        correct_dn = normalized_dn(dn)
        if not Path(json_path).exists():
            logger.info(f"{dn} references {json_path}, but this file does not exist. Removing DN")
            db.unset(dn)
            i += 1
        elif correct_dn != dn:
            logger.info(f"{dn} had the wrong format. Reformatting to {correct_dn}")
            db.unset(dn)
            db.set(correct_dn, json_path)
            i += 1
    if i:
        logger.info(f"Writing {i} changes")
        db.commit()
    else:
        logger.info(f"No errors found. Leaving DB untouched")

def complete_rebuild():
    i = 0
    future_data = {}
    for file in Path("/var/lib/univention-appcenter/apps/ox-connector/data/listener/old/").glob("*.json"):
        data = json.load(open(file))
        dn = data["dn"]
        correct_dn = helpers.normalized_dn(dn)
        future_data[correct_dn] = str(file)
        i += 1
        if i % 1000 == 0:
            logger.info(f"Read {i} files...")
    logger.info(f"Read {i} files. Writing everything now...")
    db = get_old_db()
    with db.open("n") as _db:
        for dn, path in future_data.items():
            _db[dn] = path
    logger.info("Done")

if __name__ == "__main__":
    parser = ArgumentParser(
        description="Rebuild %s. Normalized all keys, removes keys where the JSON files do not exist anymore"
    )
    parser.add_argument(
        "--fix-existing-keys",
        action="store_true",
        help="Investigates the existing DB and reformats all broken keys as well as removes all keys that link to non-existing files",
    )
    parser.add_argument(
        "--complete-rebuild",
        action="store_true",
        help="Time consuming rebuild of the DB by looking into all JSON files in listener/old/*.json",
    )
    args = parser.parse_args()
    main(args)

