#: shared_account_permission.py:48
msgid "OX Mail: Shared Account Permission"
msgstr "OX Mail: Shared Account-Berechtigung"

#: shared_account_permission.py:80
msgid "Mail"
msgstr "Mail"

#: shared_account_permission.py:89
msgid "Calendar"
msgstr "Kalender"

#: shared_account_permission.py:99
msgid ""
"Send emails directly as the shared account entity / Impersonate as shared "
"account entity during scheduling operations in the account"
msgstr ""
"E-Mails direkt als der Shared Account senden / Als Shared Account ausgeben während Terminplanungen im Account"

#: shared_account_permission.py:108
msgid ""
"Send emails on behalf of the shared account entity / Act on behalf of the "
"shared account entity during scheduling operations in the account"
msgstr ""
"E-Mails im Auftrag des Shared Account senden / Im Namen des Shared Account Terminplanungen im Account vornehmen"

#: shared_account_permission.py:117
msgid "Read-only access to shared account snippets from module io.ox/mail"
msgstr ""
"Schreibgeschützter Zugang zu Snippets des Moduls io.ox/mail im Shared Account"

#: shared_account_permission.py:126
msgid ""
"Read/write access to shared account snippets from module io.ox/mail (e.g. "
"signatures)"
msgstr ""
"Lese- und Schreibzugriff auf Snippets des Moduls io.ox/mail im Shared Account (z.B. Signaturen)"

#: shared_account_permission.py:135
msgid "Manage mail filter rules for the shared account, i.e. its Sieve scripts"
msgstr ""
"Regeln zum Filtern von Mails des Shared Accounts verwalten, z.B. dessen Sieve-Skripte"

#: shared_account_permission.py:144
msgid ""
"Write access to specific JSlob data from the shared account (e.g. for "
"changing shared configuration)"
msgstr ""
"Schreibzugriff zu bestimmten JSlob-Daten des Shared Account (z.B. die Konfigurationen ändern)"

#: shared_account_permission.py:160
msgid "Permissions"
msgstr "Berechtigungen"

#: shared_account_permission.py:167
msgid "Capabilities"
msgstr "Befähigungen"

#: shared_account_permission.py:270
msgid ""
"The deletion of the Shared Account Permission object is not allowed as long "
"as any Shared Account references it"
msgstr ""
"Das Löschen des Shared Account Permission-Objekts ist nicht erlaubt, solange ein Shared Account es noch referenziert"

#: oxcontext.py:48
msgid "OX Mail: OX context"
msgstr "OX-Mail: OX context"

#: oxcontext.py:133
msgid "\"dn\" Object exists: The Context ID has already been taken!"
msgstr "\"dn\" Objekt existiert: Die Context-ID ist bereits vergeben!"

#: oxcontext.py:144
msgid "The deletion of the OX context object is not allowed!"
msgstr "Das Löschen von OX-Context-Objekten ist nicht erlaubt!"

#: oxcontext.py:162
msgid ""
"The deletion of the OX context object is not allowed as long as users are in "
"it"
msgstr ""
"Das Löschen des OX-Context-Objekts ist nicht erlaubt, solange sich Benutzer "
"darin befinden!"

#: oxcontext.py:181
msgid ""
"The deletion of the OX context object is not allowed as long as resources "
"are in it"
msgstr ""
"Das Löschen des OX-Context-Objekts ist nicht erlaubt, solange sich Resourcen "
"darin befinden!"

