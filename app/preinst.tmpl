#!/bin/bash

# Abort on nonzero exitstatus [-e]
set -o errexit
# Don't hide errors within pipes
set -o pipefail

APP_ID="ox-connector"

PROVISIONING_CLIENT="$(mktemp)"
trap 'rm -f "${PROVISIONING_CLIENT}"' EXIT

cat <<'EOF' > "${PROVISIONING_CLIENT}"
%PROVISIONING-SERVICE-CLIENT%
EOF
chmod 700 "${PROVISIONING_CLIENT}"

# Returns 0 if this is a fresh install, 1 if upgrade
is_install() {
    # Piping `univention-app info` directly fails when run in a preinst script
    # Exception ignored in: <_io.TextIOWrapper name='<stdout>' mode='w' encoding='utf-8'>
    # BrokenPipeError: [Errno 32] Broken pipe
    app_state="$(univention-app info)"
    if echo "${app_state}" | grep -q "^Installed:.*${APP_ID}="; then
        echo "ox-connector already installed, this is an upgrade"
        return 1
    else
        echo "ox-connector not yet installed, this is a fresh install"
        return 0
    fi
}

setup_provisioning_subscriptions() {
    local subscription_file="/var/lib/univention-appcenter/apps/${APP_ID}/data/secrets/provisioning-subscription.json"
    local app_provisioning_env_file="/var/lib/univention-appcenter/apps/${APP_ID}/conf/provisioning.env"
    local -a prefill_args=()
    local topics='[
  {"realm":"udm", "topic":"users/user"},
  {"realm":"udm", "topic":"groups/group"},
  {"realm":"udm", "topic":"oxmail/oxcontext"},
  {"realm":"udm", "topic":"oxmail/accessprofile"},
  {"realm":"udm", "topic":"oxresources/oxresources"},
  {"realm":"udm", "topic":"oxmail/functional_account"},
  {"realm":"udm", "topic":"oxmail/shared_account"},
  {"realm":"udm", "topic":"oxmail/shared_account_permission"}
]'
    local provisioning_server="$(ucr get ox/connector/provisioning-server)"
    if [[ -z "${provisioning_server}" ]]; then
        provisioning_server="$(ucr get ldap/master)"
        ucr set "ox/connector/provisioning-server=${provisioning_server}"
    fi

    mkdir --parent "$(dirname "${subscription_file}")"
    mkdir --parent "$(dirname "${app_provisioning_env_file}")"

    if [[ -f "${app_provisioning_env_file}" ]]; then
        echo "${app_provisioning_env_file} already exists, skipping provisioning setup."
        return 0
    fi

    if is_install; then
        prefill_args=(--request-prefill)
        echo "Subscription will be prefilled (fresh install)"
    else
        echo "Subscription will NOT be prefilled (upgrade)"
    fi

    "${PROVISIONING_CLIENT}" subscribe \
        --provisioning-server "${provisioning_server}" \
        --subscription-file "${subscription_file}" \
        --topics "${topics}" \
        "${prefill_args[@]}" \
        "${@}"

    python3 - "${subscription_file}" > "${app_provisioning_env_file}" <<'EOF'
import json
import sys

with open(sys.argv[1]) as fd:
    credentials = json.load(fd)

print(f"export PROVISIONING_API_USERNAME={credentials['subscription_name']}")
print(f"export PROVISIONING_API_PASSWORD={credentials['subscription_password']}")
EOF
    chmod 640 "${app_provisioning_env_file}"
}

setup_docker_params() {
    local current
    current="$(ucr get "appcenter/apps/ox-connector/docker/params")"
    if [[ -n "$current" ]]; then
        echo "appcenter/apps/ox-connector/docker/params already set to '${current}', skipping."
    else
        ucr set 'appcenter/apps/ox-connector/docker/params=--restart=always'
    fi
}

# OX-Connector version 3.x initialized the attrs column with
# NOT NULL version 4.x removed this. We need to migrate the sqlite db
# unfortunately sqlite has no migration functionality
# so we need to recreate the tables
migrate_db_schema() {
    local db_file
    local migrated=0
    local rc

    for db_file in \
        "/var/lib/univention-appcenter/apps/${APP_ID}/data/ox-connector.db" \
        "/var/lib/univention-appcenter/apps/${APP_ID}/data/listener/ox-connector.db"; do
        # no db no problem
        if [[ ! -f "${db_file}" ]]; then
            continue
        fi

        echo "Checking database schema of ${db_file}"
        if python3 - "${db_file}" <<'PYEOF'
import shutil
import sqlite3
import sys
from datetime import datetime

SCHEMAS = {
    "tasks": (
        "CREATE TABLE tasks ("
        "id INTEGER NOT NULL, obj_id VARCHAR NOT NULL, "
        "udm_module VARCHAR NOT NULL, dn VARCHAR NOT NULL, attrs VARCHAR, "
        "status VARCHAR NOT NULL, num_errors INTEGER NOT NULL, "
        "created_at DATETIME, PRIMARY KEY (id))",
        "CREATE INDEX tasks_created_at ON tasks (created_at)",
    ),
    "morgue": (
        "CREATE TABLE morgue ("
        "id INTEGER NOT NULL, obj_id VARCHAR NOT NULL, "
        "udm_module VARCHAR NOT NULL, dn VARCHAR NOT NULL, attrs VARCHAR, "
        "error_msg VARCHAR NOT NULL, timestamp DATETIME, PRIMARY KEY (id))",
        "CREATE INDEX morgue_obj_id ON morgue (obj_id)",
    ),
}

db_file = sys.argv[1]
connection = sqlite3.connect(db_file, isolation_level=None)

# check if migration already happened
stale = [
    table
    for table in SCHEMAS
    if connection.execute(
        f'SELECT "notnull" FROM pragma_table_info({table!r}) '
        "WHERE name = 'attrs'",
    ).fetchone()[0]
]
if not stale:
    sys.exit(3)

backup = f"{db_file}.backup-{datetime.now():%Y%m%d-%H%M%S}"
shutil.copy2(db_file, backup)
print(f"Backing up database to {backup}")

connection.execute("BEGIN")
try:
    for table in stale:
        create_ddl, index_ddl = SCHEMAS[table]
        connection.execute(f'ALTER TABLE "{table}" RENAME TO "{table}_old"')
        connection.execute(create_ddl)
        connection.execute(
            f'INSERT INTO "{table}" SELECT * FROM "{table}_old"',
        )
        connection.execute(f'DROP TABLE "{table}_old"')
        connection.execute(index_ddl)
    connection.commit()
except Exception:
    connection.rollback()
    raise
finally:
    connection.close()
PYEOF
        then
            migrated=1
        else
            rc=$?
            if [[ ${rc} -ne 3 ]]; then
                echo "ERROR: database schema migration failed (exit ${rc})." >&2
                exit "${rc}"
            fi
        fi
    done

    if [[ ${migrated} -eq 1 ]]; then
        echo "Restarting ox-connector."
        univention-app restart "${APP_ID}"
        container="$(ucr get "appcenter/apps/${APP_ID}/container")"
        for attempt in $(seq 1 20); do
            if docker inspect --format '{{.State.Running}}' \
                "${container}" 2>/dev/null | grep -q true; then
                sleep 10
                echo "Container is running"
                break
            fi
            sleep 5
        done
    fi
}

migrate_db_schema
setup_provisioning_subscriptions "${@}"
setup_docker_params

if [[ ! -d "/var/lib/univention-appcenter/apps/${APP_ID}/data/secrets/" ]]; then
  mkdir -pv "/var/lib/univention-appcenter/apps/${APP_ID}/data/secrets"
fi
