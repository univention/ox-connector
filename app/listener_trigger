def object_from_path(path):
    """Extract object information from JSON file"""
    content = load_from_json_file(path)
    entry_uuid = content["id"]
    object_type = content["udm_object_type"]
    distinguished_name = content["dn"]
    attributes = content["object"]
    options = content["options"]
    obj = TriggerObject(
        entry_uuid,
        object_type,
        distinguished_name,
        attributes,
        options,
        path,
    )
    return obj


GROUP_EUUID = set()


def objects_from_files(delete_files=True, move_files=False):
    """
    Iterates over all JSON files and yields a TriggerObject. After the
    caller is done with it, it can delete or move the file. If it moves the
    file, a copy of this very JSON file is created so that a new run can
    reload it (useful if you need to act on various changes in
    attributes)
    """
    objs = []
    obj_dict = defaultdict(list)
    num_files = len(os.listdir(str(NEW_FILES_DIR)))
    curr = 1
    for path in sorted(NEW_FILES_DIR.glob("*.json")):
        if not curr % 10000:
            logger.info(f"file {curr} of {num_files}")
        obj = object_from_path(path)
        if move_files:
            obj.load_old()
        if obj.attributes is None and obj.old_attributes is None:
            # happens when creation and deletion happens within one
            # "listener cycle" => nothing happened
            path.unlink()
        else:
            obj_dict[obj.object_type].append(path)
            if obj.object_type == "groups/group":
                GROUP_EUUID.add(obj.entry_uuid)
        curr += 1

    # The order here is important
    ################################
    # join obj_dict sorted.
    # oxcontext removal should be done at the end.
    removed_ctxs = []
    for path in obj_dict["oxmail/oxcontext"]:
        if obj.attributes is None:
            removed_ctxs.append(path)
        else:
            objs.append(path)

    objs.extend(obj_dict["oxmail/accessprofile"])
    objs.extend(obj_dict["users/user"])
    objs.extend(obj_dict["groups/group"])
    objs.extend(obj_dict["oxmail/functional_account"])
    objs.extend(obj_dict["oxresources/oxresources"])
    objs.extend(removed_ctxs)

    ################################

    for path in objs:
        # load the file again because storing all of them in objs can result in out of memory errors when provisioning hundred of thousand objects
        obj = object_from_path(path)
        if move_files:
            obj.load_old()
        yield obj
        if move_files:
            old_file_path = obj.get_old_file_path()
            if old_file_path.exists():
                old_file_path.unlink()
            if obj.was_deleted():
                logger.info("Object was deleted. Deleting %s", path)
                path.unlink()
                if obj.old_distinguished_name:
                    unset_mapping(helpers.normalized_dn(obj.old_distinguished_name))
                unset_mapping(helpers.normalized_dn(obj.distinguished_name))
            else:
                logger.info("mv %s -> %s", path, old_file_path)
                old_file_path.parent.mkdir(parents=True, exist_ok=True)
                path.replace(old_file_path)
                if obj.was_enriched():
                    logger.info(
                        "... not done yet; enriching object by rewriting JSON file...",
                    )
                    obj.dump(old_file_path)
                if obj.old_distinguished_name and obj.old_distinguished_name != obj.distinguished_name:
                    unset_mapping(helpers.normalized_dn(obj.old_distinguished_name))
                set_mapping(helpers.normalized_dn(obj.distinguished_name), old_file_path)
        elif delete_files:
            logger.info("Deleting %s", path)
            path.unlink()



def continue_on_error(obj, e):
    traceback.print_exc()
    save_error(obj, e)
    
def stop_on_error(pause_after_errors_num, pause_after_errors_length):
    traceback.print_exc()
    errors = get_error_count()
    if 0 < pause_after_errors_num <= errors:
        logger.warning("This is consecutive error #%s", errors)
        logger.warning(
            "Sleeping for %s sec",
            pause_after_errors_length,
        )
        time.sleep(pause_after_errors_length)
    set_error_count(errors + 1) 
    return -1

def run_on_files(
    objs,
    function,
    stop_at_first_error=False,
    pause_after_errors_num=0,
    pause_after_errors_length=0,
):
    """
    Iterate over objects (returned by objects_from_files) and runs a
    function f on this object. May continue to do so even if one iteration
    failed. Returns the number of objects that were successfully processed OR
    an error code (in this case, the number is negative)
    """
    ret = 0
    seen = 0
    for obj in objs:
        logger.info("Handling %r", obj.path)
        try:
            function(obj)
        except (requests.exceptions.HTTPError) as e:
            if stop_at_first_error:
                ret = stop_on_error(pause_after_errors_num, pause_after_errors_length)
                break
            else:
                continue_on_error(obj, e)
        except Exception as e:
            continue_on_error(obj, e)
        else:
            set_error_count(0)
            seen += 1

    logger.info("Successfully processed %s files during this run", seen) 
    if ret == -1:
        return ret
    return seen


def main():
    """Handles listener-JSON-files"""
    # run forever and only exit on error
    while True:
        objs = objects_from_files(delete_files=False, move_files=True)
        files_seen = run_on_files(
            objs,
            run,
            pause_after_errors_num=3,
            pause_after_errors_length=0,
        )
        mapping.commit()
        meta.commit()
        if files_seen <= 0:
            return -files_seen
    # never reached
    return 0


if __name__ == '__main__':
    sys.exit(main())

